{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visualizadordeprocesso",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "consultadaop",
      "database_id": "a9149764-41fd-47b4-8c0c-1cea9530cd91",
      "migrations_dir": "migrations"
    }
  ]
}
